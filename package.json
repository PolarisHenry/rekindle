{
  "name": "agent-session-restore",
  "displayName": "Rekindle",
  "description": "Automatically restore your terminal agents when you reopen VS Code.",
  "version": "0.5.0",
  "publisher": "local-tools",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "*"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:integration": "node test/run-integration.js",
    "package": "vsce package --allow-star-activation --out rekindle.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.7.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "agentSessionRestore.add",
        "title": "Add Session",
        "icon": "$(add)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.restore",
        "title": "Restore Enabled Sessions",
        "icon": "$(debug-restart)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.open",
        "title": "Open Session",
        "icon": "$(terminal)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.rename",
        "title": "Rename Terminal",
        "icon": "$(edit)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.remove",
        "title": "Forget Session",
        "icon": "$(close)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.logs",
        "title": "Show Logs",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.enable",
        "title": "Enable Auto Restore",
        "icon": "$(play)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.disable",
        "title": "Disable Auto Restore",
        "icon": "$(debug-pause)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.refreshHistory",
        "title": "Refresh History",
        "icon": "$(refresh)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.showHistory",
        "title": "Show History",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.hideHistory",
        "title": "Hide History",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.groupByFolder",
        "title": "By Folder",
        "category": "Rekindle",
        "enablement": "rekindle.groupBy != folder"
      },
      {
        "command": "agentSessionRestore.groupByAgent",
        "title": "By Agent",
        "category": "Rekindle",
        "enablement": "rekindle.groupBy != agent"
      },
      {
        "command": "agentSessionRestore.showAllFolders",
        "title": "Show All Folders",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.workspaceOnly",
        "title": "Current Workspace Only",
        "category": "Rekindle"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentSessionRestoreContainer",
          "title": "Rekindle",
          "icon": "media/sessions.svg"
        }
      ]
    },
    "views": {
      "agentSessionRestoreContainer": [
        {
          "id": "agentSessionRestore.sessions",
          "name": "Sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentSessionRestore.sessions",
        "contents": "Your terminal agents, right where you left them.\n\nStart Codex, pi, Claude Code, or AGY in a normal terminal. Rekindle remembers the conversation and restores it when you reopen this workspace.\n\n[Add an existing session](command:agentSessionRestore.add)",
        "when": "!agentSessionRestore.hasSessions"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentSessionRestore.add",
          "when": "view == agentSessionRestore.sessions",
          "group": "navigation@1"
        },
        {
          "command": "agentSessionRestore.restore",
          "when": "view == agentSessionRestore.sessions",
          "group": "navigation@2"
        },
        {
          "command": "agentSessionRestore.refreshHistory",
          "when": "view == agentSessionRestore.sessions",
          "group": "navigation@3"
        },
        {
          "command": "agentSessionRestore.showHistory",
          "when": "view == agentSessionRestore.sessions && !rekindle.showHistory",
          "group": "1_view@1"
        },
        {
          "command": "agentSessionRestore.hideHistory",
          "when": "view == agentSessionRestore.sessions && rekindle.showHistory",
          "group": "1_view@1"
        },
        {
          "command": "agentSessionRestore.showAllFolders",
          "when": "view == agentSessionRestore.sessions && rekindle.workspaceOnly",
          "group": "1_view@2"
        },
        {
          "command": "agentSessionRestore.workspaceOnly",
          "when": "view == agentSessionRestore.sessions && !rekindle.workspaceOnly",
          "group": "1_view@2"
        },
        {
          "submenu": "rekindle.groupBy",
          "when": "view == agentSessionRestore.sessions",
          "group": "2_grouping@1"
        }
      ],
      "view/item/context": [
        {
          "command": "agentSessionRestore.open",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(enabledSession|disabledSession|historySession)$/",
          "group": "inline@1"
        },
        {
          "command": "agentSessionRestore.rename",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(enabledSession|disabledSession)$/",
          "group": "1_manage@1"
        },
        {
          "command": "agentSessionRestore.remove",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(enabledSession|disabledSession)$/",
          "group": "1_manage@3"
        },
        {
          "command": "agentSessionRestore.enable",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(disabledSession|historySession)$/",
          "group": "inline@2"
        },
        {
          "command": "agentSessionRestore.disable",
          "when": "view == agentSessionRestore.sessions && viewItem == enabledSession",
          "group": "inline@2"
        }
      ],
      "rekindle.groupBy": [
        {
          "command": "agentSessionRestore.groupByFolder",
          "group": "1_group@1"
        },
        {
          "command": "agentSessionRestore.groupByAgent",
          "group": "1_group@2"
        }
      ]
    },
    "configuration": {
      "title": "Rekindle",
      "properties": {
        "agentSessionRestore.autoRestore": {
          "type": "boolean",
          "default": true,
          "description": "Automatically restore tracked agent terminals when opening this workspace."
        },
        "agentSessionRestore.codexCommand": {
          "type": "string",
          "default": "codex",
          "scope": "machine",
          "description": "Codex executable name or absolute path (without arguments)."
        },
        "agentSessionRestore.piCommand": {
          "type": "string",
          "default": "pi",
          "scope": "machine",
          "description": "pi executable name or absolute path (without arguments)."
        },
        "agentSessionRestore.codexHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Codex data directory. Empty uses CODEX_HOME or ~/.codex."
        },
        "agentSessionRestore.piHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "pi data directory. Empty uses PI_CODING_AGENT_DIR or ~/.pi/agent."
        },
        "agentSessionRestore.claudeCommand": {
          "type": "string",
          "default": "claude",
          "scope": "machine",
          "description": "claude executable name or absolute path (without arguments)."
        },
        "agentSessionRestore.agyCommand": {
          "type": "string",
          "default": "agy",
          "scope": "machine",
          "description": "agy executable name or absolute path (without arguments)."
        },
        "agentSessionRestore.claudeHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "claude data directory for the history browser. Empty uses the standard location."
        },
        "agentSessionRestore.agyHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "agy data directory for the history browser. Empty uses the standard location."
        }
      }
    },
    "configurationDefaults": {
      "terminal.integrated.hideOnStartup": "whenEmpty"
    },
    "submenus": [
      {
        "id": "rekindle.groupBy",
        "label": "Group By"
      }
    ]
  },
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/PolarisHenry/rekindle.git"
  },
  "homepage": "https://github.com/PolarisHenry/rekindle#readme",
  "bugs": {
    "url": "https://github.com/PolarisHenry/rekindle/issues"
  },
  "keywords": [
    "terminal",
    "session",
    "codex",
    "claude",
    "antigravity",
    "pi"
  ],
  "dependencies": {
    "@vscode/python-environments": "1.4.0"
  }
}
