    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentSessionRestoreContainer",
          "title": "Rekindle",
          "icon": "media/sessions.svg"
        }
      ]
    },
    "views": {
      "agentSessionRestoreContainer": [
        {
          "id": "agentSessionRestore.sessions",
          "name": "Sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentSessionRestore.sessions",
        "contents": "%manifest.914583fc7bfe%",
        "when": "!agentSessionRestore.hasSessions"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentSessionRestore.add",
          "when": "view == agentSessionRestore.sessions",
          "group": "navigation@1"
        },
        {
          "command": "agentSessionRestore.restore",
          "when": "view == agentSessionRestore.sessions",
          "group": "navigation@2"
        },
        {
          "command": "agentSessionRestore.refreshHistory",
          "when": "view == agentSessionRestore.sessions",
          "group": "navigation@3"
        },
        {
          "command": "agentSessionRestore.expandAll",
          "when": "view == agentSessionRestore.sessions",
          "group": "navigation@4"
        },
        {
          "command": "agentSessionRestore.collapseAll",
          "when": "view == agentSessionRestore.sessions",
          "group": "navigation@5"
        },
        {
          "command": "agentSessionRestore.showHistory",
          "when": "view == agentSessionRestore.sessions && !rekindle.showHistory",
          "group": "1_view@1"
        },
        {
          "command": "agentSessionRestore.hideHistory",
          "when": "view == agentSessionRestore.sessions && rekindle.showHistory",
          "group": "1_view@1"
        },
        {
          "command": "agentSessionRestore.showAllFolders",
          "when": "view == agentSessionRestore.sessions && rekindle.workspaceOnly",
          "group": "1_view@2"
        },
        {
          "command": "agentSessionRestore.workspaceOnly",
          "when": "view == agentSessionRestore.sessions && !rekindle.workspaceOnly",
          "group": "1_view@2"
        },
        {
          "submenu": "rekindle.groupBy",
          "when": "view == agentSessionRestore.sessions",
          "group": "2_grouping@1"
        },
        {
          "command": "agentSessionRestore.launchSettings",
          "when": "view == agentSessionRestore.sessions",
          "group": "3_settings@1"
        },
        {
          "command": "agentSessionRestore.search",
          "when": "view == agentSessionRestore.sessions",
          "group": "navigation@0"
        },
        {
          "command": "agentSessionRestore.clearSearch",
          "when": "view == agentSessionRestore.sessions && rekindle.searchActive",
          "group": "navigation@0.5"
        },
        {
          "command": "agentSessionRestore.enableCompletionNotifications",
          "when": "view == agentSessionRestore.sessions && !rekindle.completionNotifications",
          "group": "3_settings@2"
        },
        {
          "command": "agentSessionRestore.disableCompletionNotifications",
          "when": "view == agentSessionRestore.sessions && rekindle.completionNotifications",
          "group": "3_settings@2"
        },
        {
          "submenu": "rekindle.historyRange",
          "when": "view == agentSessionRestore.sessions && rekindle.showHistory",
          "group": "1_view@3"
        },
        {
          "command": "agentSessionRestore.hideInactiveHistory",
          "when": "view == agentSessionRestore.sessions && rekindle.showHistory",
          "group": "1_view@4"
        },
        {
          "command": "agentSessionRestore.resetHiddenHistory",
          "when": "view == agentSessionRestore.sessions && rekindle.hasHiddenHistory",
          "group": "1_view@5"
        },
        {
          "submenu": "rekindle.completionLocation",
          "when": "view == agentSessionRestore.sessions",
          "group": "3_settings@3"
        },
        {
          "command": "agentSessionRestore.clearCompletionStatus",
          "when": "view == agentSessionRestore.sessions && rekindle.hasPendingCompletion",
          "group": "3_settings@4"
        },
        {
          "command": "agentSessionRestore.changeLanguage",
          "when": "view == agentSessionRestore.sessions",
          "group": "3_settings@5"
        }
      ],
      "view/item/context": [
        {
          "command": "agentSessionRestore.addHere",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(sessionFolder|sessionAgent)$/",
          "group": "inline@0"
        },
        {
          "command": "agentSessionRestore.addHere",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(sessionFolder|sessionAgent)$/",
          "group": "1_create@1"
        },
        {
          "command": "agentSessionRestore.open",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(enabledSession|disabledSession|historySession|liveSessionUnknown)/",
          "group": "inline@1"
        },
        {
          "command": "agentSessionRestore.rename",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(enabledSession|disabledSession|historySession)/",
          "group": "1_manage@1"
        },
        {
          "command": "agentSessionRestore.remove",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(enabledSession|disabledSession)/",
          "group": "1_manage@3"
        },
        {
          "command": "agentSessionRestore.enable",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(disabledSession|historySession)/",
          "group": "inline@2"
        },
        {
          "command": "agentSessionRestore.disable",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^enabledSession/",
          "group": "inline@2"
        },
        {
          "command": "agentSessionRestore.editSessionArguments",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(enabledSession|disabledSession|historySession)/",
          "group": "2_actions@1"
        },
        {
          "command": "agentSessionRestore.openWorkingFolder",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(enabledSession|disabledSession|historySession)/",
          "group": "2_actions@2"
        },
        {
          "command": "agentSessionRestore.copyResumeCommand",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(enabledSession|disabledSession|historySession)/",
          "group": "2_actions@3"
        },
        {
          "command": "agentSessionRestore.restart",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(enabledSession|disabledSession)/",
          "group": "2_actions@4"
        },
        {
          "command": "agentSessionRestore.favorite",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(enabledSession|disabledSession|historySession)/ && !(viewItem =~ /Favorite/)",
          "group": "2_actions@5"
        },
        {
          "command": "agentSessionRestore.unfavorite",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /Favorite/",
          "group": "2_actions@5"
        },
        {
          "command": "agentSessionRestore.hideHistoryEntry",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(disabledSession|historySession)/ && !(viewItem =~ /Favorite/)",
          "group": "3_history@1"
        },
        {
          "command": "agentSessionRestore.diagnostics",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /(Unknown|Failed)/",
          "group": "3_diagnostics@1"
        },
        {
          "command": "agentSessionRestore.retryRestore",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /Failed/",
          "group": "3_diagnostics@2"
        }
      ],
      "explorer/context": [
        {
          "command": "agentSessionRestore.addInFolder",
          "when": "resourceScheme == file && explorerResourceIsFolder",
          "group": "1_create@1"
        }
      ],
      "rekindle.groupBy": [
        {
          "command": "agentSessionRestore.groupByFolder",
          "group": "1_group@1"
        },
        {
          "command": "agentSessionRestore.groupByAgent",
          "group": "1_group@2"
        }
      ],
      "rekindle.historyRange": [
        {
          "command": "agentSessionRestore.historyRange1",
