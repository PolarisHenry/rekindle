{
  "name": "agent-session-restore",
  "displayName": "Rekindle",
  "description": "Automatically restore your terminal agents when you reopen VS Code.",
  "version": "0.11.13",
  "publisher": "ArionLee",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "*"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:integration": "node test/run-integration.js",
    "package:legacy-bridge": "node scripts/package-legacy-bridge.js",
    "package": "vsce package --allow-star-activation --out rekindle.vsix",
    "publish:marketplace": "npm run package && vsce publish --packagePath rekindle.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.7.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "agentSessionRestore.add",
        "title": "Add Session",
        "icon": "$(add)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.addInFolder",
        "title": "New Agent Session Here",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.addHere",
        "title": "New Session Here",
        "icon": "$(add)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.restore",
        "title": "Restore Enabled Sessions",
        "icon": "$(debug-restart)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.open",
        "title": "Open Session",
        "icon": "$(terminal)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.rename",
        "title": "Rename Terminal",
        "icon": "$(edit)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.remove",
        "title": "Forget Session",
        "icon": "$(close)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.logs",
        "title": "Show Logs",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.enable",
        "title": "Enable Auto Restore",
        "icon": "$(play)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.disable",
        "title": "Disable Auto Restore",
        "icon": "$(debug-pause)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.refreshHistory",
        "title": "Refresh History",
        "icon": "$(refresh)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.expandAll",
        "title": "Expand All Sessions",
        "icon": "$(expand-all)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.collapseAll",
        "title": "Collapse All Sessions",
        "icon": "$(collapse-all)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.showHistory",
        "title": "Show History",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.hideHistory",
        "title": "Hide History",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.groupByFolder",
        "title": "By Folder",
        "category": "Rekindle",
        "enablement": "rekindle.groupBy != folder"
      },
      {
        "command": "agentSessionRestore.groupByAgent",
        "title": "By Agent",
        "category": "Rekindle",
        "enablement": "rekindle.groupBy != agent"
      },
      {
        "command": "agentSessionRestore.showAllFolders",
        "title": "Show All Folders",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.workspaceOnly",
        "title": "Current Workspace Only",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.launchSettings",
        "title": "Agent Launch Settings",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.search",
        "title": "Search Sessions",
        "category": "Rekindle",
        "icon": "$(search)"
      },
      {
        "command": "agentSessionRestore.clearSearch",
        "title": "Clear Search",
        "category": "Rekindle",
        "icon": "$(clear-all)"
      },
      {
        "command": "agentSessionRestore.enableCompletionNotifications",
        "title": "Enable Completion Notifications",
        "category": "Rekindle",
        "icon": "$(bell)"
      },
      {
        "command": "agentSessionRestore.disableCompletionNotifications",
        "title": "Disable Completion Notifications",
        "category": "Rekindle",
        "icon": "$(bell-slash)"
      },
      {
        "command": "agentSessionRestore.editSessionArguments",
        "title": "Edit Session Arguments",
        "icon": "$(gear)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.openWorkingFolder",
        "title": "Open Working Folder",
        "icon": "$(folder-opened)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.copyResumeCommand",
        "title": "Copy Resume Command",
        "icon": "$(clippy)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.restart",
        "title": "Restart Session",
        "icon": "$(debug-restart)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.favorite",
        "title": "Favorite Session",
        "icon": "$(star-full)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.unfavorite",
        "title": "Unfavorite Session",
        "icon": "$(star-empty)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.hideHistoryEntry",
        "title": "Hide from History",
        "icon": "$(eye-closed)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.hideInactiveHistory",
        "title": "Hide Visible Inactive History",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.resetHiddenHistory",
        "title": "Reset Hidden History",
        "icon": "$(history)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.historyRange1",
        "title": "Last 1 day",
        "category": "Rekindle",
        "enablement": "rekindle.historyRangeDays != 1"
      },
      {
        "command": "agentSessionRestore.historyRange3",
        "title": "Last 3 days",
        "category": "Rekindle",
        "enablement": "rekindle.historyRangeDays != 3"
      },
      {
        "command": "agentSessionRestore.historyRange7",
        "title": "Last 7 days",
        "category": "Rekindle",
        "enablement": "rekindle.historyRangeDays != 7"
      },
      {
        "command": "agentSessionRestore.historyRange15",
        "title": "Last 15 days",
        "category": "Rekindle",
        "enablement": "rekindle.historyRangeDays != 15"
      },
      {
        "command": "agentSessionRestore.historyRange30",
        "title": "Last 30 days",
        "category": "Rekindle",
        "enablement": "rekindle.historyRangeDays != 30"
      },
      {
        "command": "agentSessionRestore.historyRangeAll",
        "title": "All History",
        "category": "Rekindle",
        "enablement": "rekindle.historyRangeDays != 'all'"
      },
      {
        "command": "agentSessionRestore.historyRangeCustom",
        "title": "Custom Days…",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.diagnostics",
        "title": "Show Diagnostics",
        "icon": "$(output)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.retryRestore",
        "title": "Retry Restore",
        "icon": "$(debug-restart)",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.openCompletionStatus",
        "title": "Open Completed Sessions",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.clearCompletionStatus",
        "title": "Clear Status Bar Reminders",
        "category": "Rekindle"
      },
      {
        "command": "agentSessionRestore.completionLocationStatusBar",
        "title": "Use Status Bar Reminders",
        "category": "Rekindle",
        "enablement": "rekindle.completionNotificationLocation != statusBar"
      },
      {
        "command": "agentSessionRestore.completionLocationNative",
        "title": "Use Native Notifications",
        "category": "Rekindle",
        "enablement": "rekindle.completionNotificationLocation != native"
      },
      {
        "command": "agentSessionRestore.completionLocationBoth",
        "title": "Use Both Reminder Locations",
        "category": "Rekindle",
        "enablement": "rekindle.completionNotificationLocation != both"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentSessionRestoreContainer",
          "title": "Rekindle",
          "icon": "media/sessions.svg"
        }
      ]
    },
    "views": {
      "agentSessionRestoreContainer": [
        {
          "id": "agentSessionRestore.sessions",
          "name": "Sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentSessionRestore.sessions",
        "contents": "Your terminal agents, right where you left them.\n\nStart Codex, pi, Claude Code, or AGY in a normal terminal. Rekindle remembers the conversation and restores it when you reopen this workspace.\n\n[Add an existing session](command:agentSessionRestore.add)",
        "when": "!agentSessionRestore.hasSessions"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentSessionRestore.add",
          "when": "view == agentSessionRestore.sessions",
          "group": "navigation@1"
        },
        {
          "command": "agentSessionRestore.restore",
          "when": "view == agentSessionRestore.sessions",
          "group": "navigation@2"
        },
        {
          "command": "agentSessionRestore.refreshHistory",
          "when": "view == agentSessionRestore.sessions",
          "group": "navigation@3"
        },
        {
          "command": "agentSessionRestore.expandAll",
          "when": "view == agentSessionRestore.sessions",
          "group": "navigation@4"
        },
        {
          "command": "agentSessionRestore.collapseAll",
          "when": "view == agentSessionRestore.sessions",
          "group": "navigation@5"
        },
        {
          "command": "agentSessionRestore.showHistory",
          "when": "view == agentSessionRestore.sessions && !rekindle.showHistory",
          "group": "1_view@1"
        },
        {
          "command": "agentSessionRestore.hideHistory",
          "when": "view == agentSessionRestore.sessions && rekindle.showHistory",
          "group": "1_view@1"
        },
        {
          "command": "agentSessionRestore.showAllFolders",
          "when": "view == agentSessionRestore.sessions && rekindle.workspaceOnly",
          "group": "1_view@2"
        },
        {
          "command": "agentSessionRestore.workspaceOnly",
          "when": "view == agentSessionRestore.sessions && !rekindle.workspaceOnly",
          "group": "1_view@2"
        },
        {
          "submenu": "rekindle.groupBy",
          "when": "view == agentSessionRestore.sessions",
          "group": "2_grouping@1"
        },
        {
          "command": "agentSessionRestore.launchSettings",
          "when": "view == agentSessionRestore.sessions",
          "group": "3_settings@1"
        },
        {
          "command": "agentSessionRestore.search",
          "when": "view == agentSessionRestore.sessions",
          "group": "navigation@0"
        },
        {
          "command": "agentSessionRestore.clearSearch",
          "when": "view == agentSessionRestore.sessions && rekindle.searchActive",
          "group": "navigation@0.5"
        },
        {
          "command": "agentSessionRestore.enableCompletionNotifications",
          "when": "view == agentSessionRestore.sessions && !rekindle.completionNotifications",
          "group": "3_settings@2"
        },
        {
          "command": "agentSessionRestore.disableCompletionNotifications",
          "when": "view == agentSessionRestore.sessions && rekindle.completionNotifications",
          "group": "3_settings@2"
        },
        {
          "submenu": "rekindle.historyRange",
          "when": "view == agentSessionRestore.sessions && rekindle.showHistory",
          "group": "1_view@3"
        },
        {
          "command": "agentSessionRestore.hideInactiveHistory",
          "when": "view == agentSessionRestore.sessions && rekindle.showHistory",
          "group": "1_view@4"
        },
        {
          "command": "agentSessionRestore.resetHiddenHistory",
          "when": "view == agentSessionRestore.sessions && rekindle.hasHiddenHistory",
          "group": "1_view@5"
        },
        {
          "submenu": "rekindle.completionLocation",
          "when": "view == agentSessionRestore.sessions",
          "group": "3_settings@3"
        },
        {
          "command": "agentSessionRestore.clearCompletionStatus",
          "when": "view == agentSessionRestore.sessions && rekindle.hasPendingCompletion",
          "group": "3_settings@4"
        }
      ],
      "view/item/context": [
        {
          "command": "agentSessionRestore.addHere",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(sessionFolder|sessionAgent)$/",
          "group": "inline@0"
        },
        {
          "command": "agentSessionRestore.addHere",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(sessionFolder|sessionAgent)$/",
          "group": "1_create@1"
        },
        {
          "command": "agentSessionRestore.open",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(enabledSession|disabledSession|historySession|liveSessionUnknown)/",
          "group": "inline@1"
        },
        {
          "command": "agentSessionRestore.rename",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(enabledSession|disabledSession|historySession)/",
          "group": "1_manage@1"
        },
        {
          "command": "agentSessionRestore.remove",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(enabledSession|disabledSession)/",
          "group": "1_manage@3"
        },
        {
          "command": "agentSessionRestore.enable",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(disabledSession|historySession)/",
          "group": "inline@2"
        },
        {
          "command": "agentSessionRestore.disable",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^enabledSession/",
          "group": "inline@2"
        },
        {
          "command": "agentSessionRestore.editSessionArguments",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(enabledSession|disabledSession|historySession)/",
          "group": "2_actions@1"
        },
        {
          "command": "agentSessionRestore.openWorkingFolder",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(enabledSession|disabledSession|historySession)/",
          "group": "2_actions@2"
        },
        {
          "command": "agentSessionRestore.copyResumeCommand",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(enabledSession|disabledSession|historySession)/",
          "group": "2_actions@3"
        },
        {
          "command": "agentSessionRestore.restart",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(enabledSession|disabledSession)/",
          "group": "2_actions@4"
        },
        {
          "command": "agentSessionRestore.favorite",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(enabledSession|disabledSession|historySession)/ && !(viewItem =~ /Favorite/)",
          "group": "2_actions@5"
        },
        {
          "command": "agentSessionRestore.unfavorite",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /Favorite/",
          "group": "2_actions@5"
        },
        {
          "command": "agentSessionRestore.hideHistoryEntry",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /^(disabledSession|historySession)/ && !(viewItem =~ /Favorite/)",
          "group": "3_history@1"
        },
        {
          "command": "agentSessionRestore.diagnostics",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /(Unknown|Failed)/",
          "group": "3_diagnostics@1"
        },
        {
          "command": "agentSessionRestore.retryRestore",
          "when": "view == agentSessionRestore.sessions && viewItem =~ /Failed/",
          "group": "3_diagnostics@2"
        }
      ],
      "explorer/context": [
        {
          "command": "agentSessionRestore.addInFolder",
          "when": "resourceScheme == file && explorerResourceIsFolder",
          "group": "1_create@1"
        }
      ],
      "rekindle.groupBy": [
        {
          "command": "agentSessionRestore.groupByFolder",
          "group": "1_group@1"
        },
        {
          "command": "agentSessionRestore.groupByAgent",
          "group": "1_group@2"
        }
      ],
      "rekindle.historyRange": [
        {
          "command": "agentSessionRestore.historyRange1",
          "group": "1_range@1"
        },
        {
          "command": "agentSessionRestore.historyRange3",
          "group": "1_range@2"
        },
        {
          "command": "agentSessionRestore.historyRange7",
          "group": "1_range@3"
        },
        {
          "command": "agentSessionRestore.historyRange15",
          "group": "1_range@4"
        },
        {
          "command": "agentSessionRestore.historyRange30",
          "group": "1_range@5"
        },
        {
          "command": "agentSessionRestore.historyRangeAll",
          "group": "1_range@6"
        },
        {
          "command": "agentSessionRestore.historyRangeCustom",
          "group": "1_range@7"
        }
      ],
      "rekindle.completionLocation": [
        {
          "command": "agentSessionRestore.completionLocationStatusBar",
          "group": "1_location@1"
        },
        {
          "command": "agentSessionRestore.completionLocationNative",
          "group": "1_location@2"
        },
        {
          "command": "agentSessionRestore.completionLocationBoth",
          "group": "1_location@3"
        }
      ]
    },
    "configuration": {
      "title": "Rekindle",
      "properties": {
        "agentSessionRestore.autoRestore": {
          "type": "boolean",
          "default": true,
          "description": "Automatically restore tracked agent terminals when opening this workspace."
        },
        "agentSessionRestore.completionNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Master switch for completion reminders in any location. Enabled by default; turn off from the Sessions view menu or set false."
        },
        "agentSessionRestore.codexCommand": {
          "type": "string",
          "default": "codex",
          "scope": "machine",
          "description": "Codex executable name or absolute path (without arguments)."
        },
        "agentSessionRestore.piCommand": {
          "type": "string",
          "default": "pi",
          "scope": "machine",
          "description": "pi executable name or absolute path (without arguments)."
        },
        "agentSessionRestore.codexHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Codex data directory. Empty uses CODEX_HOME or ~/.codex."
        },
        "agentSessionRestore.piHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "pi data directory. Empty uses PI_CODING_AGENT_DIR or ~/.pi/agent."
        },
        "agentSessionRestore.claudeCommand": {
          "type": "string",
          "default": "claude",
          "scope": "machine",
          "description": "claude executable name or absolute path (without arguments)."
        },
        "agentSessionRestore.agyCommand": {
          "type": "string",
          "default": "agy",
          "scope": "machine",
          "description": "agy executable name or absolute path (without arguments)."
        },
        "agentSessionRestore.claudeHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "claude data directory for the history browser. Empty uses the standard location."
        },
        "agentSessionRestore.agyHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "agy data directory for the history browser. Empty uses the standard location."
        },
        "agentSessionRestore.codexArguments": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\u0000\\r\\n]*$"
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "Extra Codex startup arguments used when restoring or opening a session. Each item is one argument (for example, `--yolo`). Applied before the exact-session resume arguments. Changes take effect the next time the agent starts."
        },
        "agentSessionRestore.piArguments": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\u0000\\r\\n]*$"
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "Extra pi startup arguments used when restoring or opening a session. Each item is one argument (for example, `--model`). Applied before the exact-session resume arguments. Changes take effect the next time the agent starts."
        },
        "agentSessionRestore.claudeArguments": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\u0000\\r\\n]*$"
          },
          "default": [
            "--permission-mode",
            "bypassPermissions"
          ],
          "scope": "machine",
          "markdownDescription": "Extra Claude Code startup arguments used when restoring or opening a session. Each item is one argument (for example, `--dangerously-skip-permissions`). Applied before the exact-session resume arguments. Changes take effect the next time the agent starts."
        },
        "agentSessionRestore.agyArguments": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\u0000\\r\\n]*$"
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "Extra AGY startup arguments used when restoring or opening a session. Each item is one argument (for example, `--dangerously-skip-permissions`). Applied before the exact-session resume arguments. Changes take effect the next time the agent starts."
        },
        "agentSessionRestore.historyRangeDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 36500,
          "default": 30,
          "scope": "window",
          "description": "Initial History Range in days when this workspace has no saved Sessions view choice. The Sessions → … → History Range menu stores later selections per workspace."
        },
        "agentSessionRestore.completionNotificationLocation": {
          "type": "string",
          "enum": [
            "statusBar",
            "native",
            "both"
          ],
          "enumDescriptions": [
            "Show persistent clickable reminders in the status bar (default).",
            "Show the compact native VS Code toast.",
            "Show both the status bar reminder and native toast."
          ],
          "default": "statusBar",
          "scope": "window",
          "description": "Where to show completed-session reminders. The existing completionNotifications setting disables all reminder locations."
        },
        "agentSessionRestore.sessionPulse": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Animate the provider dot for a session while it is working. Set false to disable the pulse."
        },
        "agentSessionRestore.codexDedicatedProcess": {
          "type": "boolean",
          "default": true,
          "description": "Use a dedicated Codex process for each terminal when the CLI supports it. Improves exact session tracking when multiple Codex terminals share a folder. Takes effect on the next agent launch."
        }
      }
    },
    "configurationDefaults": {
      "terminal.integrated.hideOnStartup": "whenEmpty",
      "terminal.integrated.tabs.description": "${task}${separator}${local}${separator}${cwdFolder}${separator}${progress}"
    },
    "submenus": [
      {
        "id": "rekindle.groupBy",
        "label": "Group By"
      },
      {
        "id": "rekindle.historyRange",
        "label": "History Range"
      },
      {
        "id": "rekindle.completionLocation",
        "label": "Completion Reminder Location"
      }
    ]
  },
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/PolarisHenry/rekindle.git"
  },
  "homepage": "https://github.com/PolarisHenry/rekindle#readme",
  "bugs": {
    "url": "https://github.com/PolarisHenry/rekindle/issues"
  },
  "keywords": [
    "terminal",
    "session",
    "codex",
    "claude",
    "antigravity",
    "pi"
  ],
  "dependencies": {
    "@vscode/python-environments": "1.4.0"
  }
}